<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base: hereda Material3 DayNight sin ActionBar -->
    <style name="Base.Theme.FinanSync" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores primarios -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>

        <!-- Colores secundarios -->
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>

        <!-- Terciario -->
        <item name="colorTertiary">@color/colorTertiary</item>
        <item name="colorTertiaryContainer">@color/colorTertiaryContainer</item>

        <!-- Superficie y fondo -->
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorOnSurfaceVariant">@color/colorOnSurfaceVariant</item>
        <item name="colorOutline">@color/colorOutline</item>
        <item name="colorOutlineVariant">@color/colorOutlineVariant</item>

        <!-- Error -->
        <item name="colorError">@color/colorError</item>
        <item name="colorErrorContainer">@color/colorErrorContainer</item>

        <!-- Tipografía: usa la fuente del sistema por defecto (sans-serif) -->
        <item name="android:fontFamily">sans-serif</item>

        <!-- StatusBar: fondo primario, iconos claros -->
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- NavigationBar: fondo superficial -->
        <item name="android:navigationBarColor">@color/colorSurface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- Tema aplicado a la app -->
    <style name="Theme.FinanSync" parent="Base.Theme.FinanSync" />

    <!-- ── Estilos de texto reutilizables ── -->
    <style name="TextAppearance.FinanSync.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/colorOnSurface</item>
    </style>

    <style name="TextAppearance.FinanSync.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/colorOnSurface</item>
    </style>

    <style name="TextAppearance.FinanSync.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/colorOnSurfaceVariant</item>
    </style>

    <!-- ── Estilo de tarjeta elevada ── -->
    <style name="Widget.FinanSync.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- ── Botón primario ── -->
    <style name="Widget.FinanSync.Button" parent="Widget.Material3.Button">
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- ── BottomNavigationView ── -->
    <style name="Widget.FinanSync.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/colorSurface</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
    </style>

</resources>