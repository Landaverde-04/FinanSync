<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de inicio (menú) del módulo. Botones que navegan a cada pantalla. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?attr/colorSurface">

    <!-- Encabezado -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💰 FinanSync"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Módulo de Transacciones"
        android:textSize="16sp"
        android:textColor="@color/gris_texto"
        android:layout_marginBottom="40dp" />

    <!-- Botón: Agregar transacción (FUNCIONA) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAgregar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="➕  Agregar transacción"
        android:textSize="16sp"
        android:gravity="start|center_vertical"
        android:paddingVertical="20dp"
        android:layout_marginBottom="16dp"
        app:cornerRadius="12dp" />

    <!-- Botón: Ver movimientos (lo conectamos cuando hagamos la lista) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMovimientos"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📋  Ver movimientos"
        android:textSize="16sp"
        android:gravity="start|center_vertical"
        android:paddingVertical="20dp"
        android:layout_marginBottom="16dp"
        app:cornerRadius="12dp" />

    <!-- Botón: Reportes (placeholder para más adelante) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReportes"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📊  Reportes"
        android:textSize="16sp"
        android:gravity="start|center_vertical"
        android:paddingVertical="20dp"
        app:cornerRadius="12dp" />

    <!-- Botón: Ajustes / Tema visual (M5) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAjustes"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚙️  Ajustes"
        android:textSize="16sp"
        android:gravity="start|center_vertical"
        android:paddingVertical="20dp"
        android:layout_marginTop="16dp"
        app:cornerRadius="12dp" />

</LinearLayout>
