<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Ícono Emoji -->
        <TextView
            android:id="@+id/iconoFila"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="🍔"
            android:textSize="22sp"
            android:background="@drawable/circulo_gris" />

        <!-- Sección Central de Información y Barra -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp">

            <!-- Fila 1: Nombre de Categoría y Periodo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtNombrePresupuesto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comida"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/txtPeriodoPresupuesto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(mensual)"
                    android:textSize="12sp"
                    android:textColor="@color/gris_texto"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Fila 2: Valores y Porcentaje -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtValoresPresupuesto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="$180.00 / $200.00"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/txtPorcentajePresupuesto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="90%"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- Barra de Progreso Material Components -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressPresupuesto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:trackColor="#E2E8F0"
                app:trackCornerRadius="4dp"
                app:trackThickness="6dp" />

        </LinearLayout>

        <!-- Botón de Eliminar -->
        <ImageButton
            android:id="@+id/btnEliminarPresupuesto"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="?attr/colorError"
            android:contentDescription="Eliminar presupuesto" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
