<?xml version="1.0" encoding="utf-8"?>
<!-- Diseño de UNA fila de la lista de transacciones.
     El Adapter rellena estos elementos con los datos de cada TransaccionEntidad. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="?attr/selectableItemBackground">

    <!-- Ícono circular de color (rojo gasto / verde ingreso) -->
    <TextView
        android:id="@+id/iconoFila"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="➖"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:background="@drawable/circulo_tipo" />

    <!-- Descripción + categoría (ocupa el espacio del medio) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp">

        <TextView
            android:id="@+id/txtDescripcionFila"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtFechaFila"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categoría · 14/Jun/2026"
            android:textSize="13sp"
            android:textColor="@color/gris_texto"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Monto, alineado a la derecha, con color según tipo -->
    <TextView
        android:id="@+id/txtMontoFila"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-$0.00"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/rojo_gasto" />

</LinearLayout>
