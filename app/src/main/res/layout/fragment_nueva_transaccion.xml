<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de Nueva Transacción (rediseñada). Preparada para modo oscuro. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="?attr/colorSurface">

    <!-- ══════════ PESTAÑAS tipo segmento: Ingreso / Gasto ══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="16dp"
        android:padding="6dp"
        android:background="@drawable/fondo_tarjeta">

        <LinearLayout
            android:id="@+id/tabIngreso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/lblIngreso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="➕  Ingreso"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/verde_ingreso" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabGasto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/lblGasto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="➖  Gasto"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/gris_texto" />
        </LinearLayout>
    </LinearLayout>

    <!-- Indicadores ocultos (el Fragment los referencia; ya no se usan visualmente
         porque ahora la pestaña activa se resalta con fondo). Se mantienen para no romper el código. -->
    <View
        android:id="@+id/indicadorIngreso"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <View
        android:id="@+id/indicadorGasto"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/fondo_tarjeta">

            <!-- ── CABECERA DEL MONTO (con fondo de color) ── -->
            <LinearLayout
                android:id="@+id/cabeceraMonto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:background="@drawable/fondo_cabecera_monto">

                <TextView
                    android:id="@+id/iconoTipo"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:gravity="center"
                    android:text="➕"
                    android:textSize="22sp"
                    android:textColor="@color/white"
                    android:background="@drawable/circulo_tipo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:id="@+id/lblMonto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MONTO"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textColor="@color/cabecera_ingreso_texto" />

                    <EditText
                        android:id="@+id/inputMonto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="0"
                        android:textColorHint="@color/gris_texto"
                        android:textColor="@color/cabecera_ingreso_texto"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnCalculadora"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@android:drawable/ic_menu_edit"
                    android:contentDescription="Calculadora"
                    app:tint="@color/cabecera_ingreso_texto" />
            </LinearLayout>

            <!-- ── Contenido del formulario ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- CATEGORÍA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CATEGORÍA"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textColor="@color/gris_texto" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="❓"
                        android:textSize="16sp"
                        android:background="@drawable/circulo_gris" />

                    <Spinner
                        android:id="@+id/spinnerCategoria"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <!-- DESCRIPCIÓN -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DESCRIPCIÓN"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textColor="@color/gris_texto" />

                <EditText
                    android:id="@+id/inputDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Escribe una nota…"
                    android:textColorHint="@color/gris_texto"
                    android:inputType="text"
                    android:paddingVertical="8dp"
                    android:layout_marginBottom="14dp" />

                <!-- UBICACIÓN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/fondo_tarjeta">

                    <TextView
                        android:id="@+id/txtUbicacion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📍 Obteniendo ubicación…"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchUbicacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <!-- ══════════ AHORRO (solo visible en INGRESO) ══════════ -->
                <LinearLayout
                    android:id="@+id/seccionAhorro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="8dp"
                        android:background="?attr/colorOutlineVariant" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkAhorro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Destinar parte a un plan de ahorro" />

                    <LinearLayout
                        android:id="@+id/detalleAhorro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:paddingStart="8dp"
                        android:paddingTop="4dp">

                        <LinearLayout
                            android:id="@+id/contenedorAportes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAgregarPlan"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="➕ Agregar otro plan"
                            android:textSize="13sp"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/txtTotalAhorro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ── Fecha / Hora (chips centrados) ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingTop="20dp">

                    <TextView
                        android:id="@+id/txtFecha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅 14/Jun"
                        android:textSize="14sp"
                        android:padding="10dp"
                        android:background="@drawable/fondo_tarjeta"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/txtHora"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕐 02:59"
                        android:textSize="14sp"
                        android:padding="10dp"
                        android:background="@drawable/fondo_tarjeta" />
                </LinearLayout>

                <!-- ── Botón Guardar (ancho completo, debajo) ── -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Guardar"
                    android:textSize="16sp"
                    android:paddingVertical="14dp"
                    android:layout_marginTop="20dp"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ══════════ BARRA INFERIOR: galería / cámara ══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:background="?attr/colorSurface">

        <ImageView
            android:id="@+id/btnGaleria"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="Galería"
            app:tint="@color/gris_texto"
            android:layout_marginEnd="48dp" />

        <ImageView
            android:id="@+id/btnCamara"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="Cámara"
            app:tint="@color/gris_texto" />
    </LinearLayout>

</LinearLayout>
