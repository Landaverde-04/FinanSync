<?xml version="1.0" encoding="utf-8"?>
<!-- Calculadora integrada (diálogo emergente). Display arriba, teclado de botones abajo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Display: muestra el número/operación actual -->
    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="36sp"
        android:textStyle="bold"
        android:gravity="end"
        android:paddingVertical="16dp"
        android:maxLines="1"
        android:ellipsize="start" />

    <!-- Teclado: 4 columnas -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:useDefaultMargins="true">

        <!-- Fila 1: C  ÷  ×  ⌫ -->
        <Button android:id="@+id/btnC" android:text="C" style="@style/BotonCalc" />
        <Button android:id="@+id/btnDiv" android:text="÷" style="@style/BotonCalc" />
        <Button android:id="@+id/btnMult" android:text="×" style="@style/BotonCalc" />
        <Button android:id="@+id/btnBorrar" android:text="⌫" style="@style/BotonCalc" />

        <!-- Fila 2: 7 8 9 − -->
        <Button android:id="@+id/btn7" android:text="7" style="@style/BotonCalc" />
        <Button android:id="@+id/btn8" android:text="8" style="@style/BotonCalc" />
        <Button android:id="@+id/btn9" android:text="9" style="@style/BotonCalc" />
        <Button android:id="@+id/btnRes" android:text="−" style="@style/BotonCalc" />

        <!-- Fila 3: 4 5 6 + -->
        <Button android:id="@+id/btn4" android:text="4" style="@style/BotonCalc" />
        <Button android:id="@+id/btn5" android:text="5" style="@style/BotonCalc" />
        <Button android:id="@+id/btn6" android:text="6" style="@style/BotonCalc" />
        <Button android:id="@+id/btnSum" android:text="+" style="@style/BotonCalc" />

        <!-- Fila 4: 1 2 3 = (= ocupa 2 filas de alto) -->
        <Button android:id="@+id/btn1" android:text="1" style="@style/BotonCalc" />
        <Button android:id="@+id/btn2" android:text="2" style="@style/BotonCalc" />
        <Button android:id="@+id/btn3" android:text="3" style="@style/BotonCalc" />
        <Button android:id="@+id/btnIgual" android:text="=" style="@style/BotonCalc"
            android:layout_rowSpan="2" android:layout_gravity="fill" />

        <!-- Fila 5: 0 (doble ancho)  . -->
        <Button android:id="@+id/btn0" android:text="0" style="@style/BotonCalc"
            android:layout_columnSpan="2" android:layout_gravity="fill_horizontal" />
        <Button android:id="@+id/btnPunto" android:text="." style="@style/BotonCalc" />
    </GridLayout>

    <!-- Botón usar resultado -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUsar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Usar resultado"
        android:layout_marginTop="8dp" />

</LinearLayout>
