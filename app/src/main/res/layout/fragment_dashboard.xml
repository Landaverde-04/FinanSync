<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <TextView
                android:id="@+id/txtSaludo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hola 👋"
                android:textColor="#0F172A"
                android:textSize="24sp"
                android:fontFamily="sans-serif-black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#0F172A"
                app:cardCornerRadius="28dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/txtSaludo">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/lblDisponible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Balance Disponible"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:baselineAligned="true"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/lblDisponible">

                        <TextView
                            android:id="@+id/txtBalanceTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$1,250"
                            android:textColor="#FFFFFF"
                            android:textSize="36sp"
                            android:fontFamily="sans-serif-black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=".00"
                            android:textColor="#64748B"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-bold" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/lblDistribucion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Categorías de Gastos"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardBalance"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGrafico"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/lblDistribucion">

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChartGastos"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/lblAcciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Acciones del Módulo"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardGrafico"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCrearPlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="✨   Crear nuevo plan de ahorro"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="start|center_vertical"
                android:paddingVertical="16dp"
                app:backgroundTint="#2563EB"
                app:cornerRadius="16dp"
                app:layout_constraintTop_toBottomOf="@id/lblAcciones" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGraficoReportes"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="📊   Ver gráficos y reportes detallados"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="start|center_vertical"
                android:paddingVertical="16dp"
                android:textColor="#0F172A"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:layout_constraintTop_toBottomOf="@id/btnCrearPlan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnListaPlanes"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:text="📋   Consultar lista de planes"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="start|center_vertical"
                android:paddingVertical="16dp"
                android:textColor="#0F172A"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnGraficoReportes" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>