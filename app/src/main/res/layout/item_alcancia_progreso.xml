<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="12dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOnSurface"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtNombreAlcancia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/txtProgresoTexto"
                android:layout_alignParentStart="true"
                android:text="Nombre Alcancía"
                android:textSize="16sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="?attr/colorOnSurface"
                android:ellipsize="end"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/txtProgresoTexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="$0.00 / $1000.00"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#2563EB" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/txtReglaAhorro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/txtEstadoAlcancia"
                android:text="Regla de ahorro"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.6" />

            <TextView
                android:id="@+id/txtEstadoAlcancia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Estado"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.8" />
        </RelativeLayout>

        <ProgressBar
            android:id="@+id/progressAlcancia"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:progress="0"
            android:progressTint="#2563EB"
            android:progressBackgroundTint="?attr/colorOnSurface"
            android:progressBackgroundTintMode="src_over" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>